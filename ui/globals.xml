<globals>

	<api>

		<!-- Gear selector state -->

		<enumdef name="GearPosition">

			<enum name="GEAR_PARK" value="0" />

			<enum name="GEAR_REVERSE" value="1" />

			<enum name="GEAR_NEUTRAL" value="2" />

			<enum name="GEAR_DRIVE" value="3" />

			<enum name="GEAR_BRAKE" value="4" />

		</enumdef>



		<!-- Ready / fault state for status indicators -->

		<enumdef name="SysState">

			<enum name="SYS_FAULT" value="0" />

			<enum name="SYS_READY" value="1" />

			<enum name="SYS_ACTIVE" value="2" />

			<enum name="SYS_CHARGE" value="3" />

			<enum name="SYS_OFF" value="4" />

		</enumdef>



		<!-- Right-hand info gauge panel (button cycles 0–2; 3 when charging) -->

		<enumdef name="InfoPanel">

			<enum name="INFO_PANEL_PACK_VOLTAGE" value="0" />

			<enum name="INFO_PANEL_CELL_BALANCE" value="1" />

			<enum name="INFO_PANEL_EFFICIENCY" value="2" />

			<enum name="INFO_PANEL_CHARGING" value="3" />

			<enum name="INFO_PANEL_SOH" value="4" />

		</enumdef>

	</api>



	<consts>

		<!-- ── Brand palette (Big Shoulders dash theme) ──────── -->

		<color name="COLOR_BLACK" value="0x000000" />

		<color name="COLOR_GRAY00" value="0x101010" />

		<color name="COLOR_GRAY0" value="0x212121" />

		<color name="COLOR_GRAY1" value="0x404040" />

		<color name="COLOR_GRAY2" value="0x9A9A9A" />

		<color name="COLOR_GRAY3" value="0xC9C9C9" />

		<color name="COLOR_BLUE" value="0x67A2F1" />

		<color name="COLOR_RED" value="0x920027" />

		<color name="COLOR_GREEN" value="0x399A65" />

		<color name="COLOR_YELLOW_DARK" value="0xC3A205" />

		<color name="COLOR_YELLOW" value="0xF3E176" />

		<color name="COLOR_WHITE" value="0xFFFFFF" />



		<!-- ── Semantic roles (map to palette above) ─────────── -->

		<color name="COLOR_BG" value="0x101010" />

		<color name="COLOR_SURFACE" value="0x212121" />

		<color name="COLOR_BORDER" value="0x404040" />

		<color name="COLOR_GREY_DARK" value="0x404040" />

		<color name="COLOR_GREY_LIGHT" value="0xC9C9C9" />



		<color name="COLOR_ACCENT" value="0x67A2F1" />

		<color name="COLOR_ACCENT_DIM" value="0x212121" />



		<color name="COLOR_OK" value="0x399A65" />

		<color name="COLOR_WARNING" value="0xC3A205" />

		<color name="COLOR_DANGER" value="0x920027" />



		<color name="COLOR_TEXT_HI" value="0xC9C9C9" />

		<color name="COLOR_TEXT_MID" value="0x9A9A9A" />

		<color name="COLOR_TEXT_LO" value="0x404040" />



		<!-- Gauge / dial -->

		<color name="COLOR_GAUGE_ACTIVE" value="0xF3E176" />

		<color name="COLOR_GAUGE_TRACK" value="0x212121" />

		<color name="COLOR_GREEN_MID" value="0x399A65" />

		<color name="COLOR_GREEN_DARK" value="0x404040" />



		<!-- Typography sizes (px) — Big Shoulders Bold -->

		<int name="FONT_SIZE_DISPLAY" value="54" />

		<int name="FONT_SIZE_HEADING" value="25" />

		<int name="FONT_SIZE_SUBHEAD" value="18" />

		<int name="FONT_SIZE_BODY" value="16" />

		<int name="FONT_SIZE_SMALL" value="12" />



		<!-- 10% letter spacing (px, rounded) per font size -->

		<int name="FONT_LETTER_SPACE_DISPLAY" value="5" />

		<int name="FONT_LETTER_SPACE_HEADING" value="3" />

		<int name="FONT_LETTER_SPACE_SUBHEAD" value="2" />

		<int name="FONT_LETTER_SPACE_BODY" value="2" />

		<int name="FONT_LETTER_SPACE_SMALL" value="1" />



		<!-- SoC colour thresholds -->

		<int name="SOC_WARN_PCT" value="20" />

		<int name="SOC_CRIT_PCT" value="10" />



		<!-- Temp warning thresholds (°C) -->

		<int name="TEMP_WARN_C" value="70" />

		<int name="TEMP_CRIT_C" value="85" />

	</consts>



	<subjects>

		<!-- ── Drivetrain ─────────────────────────────────── -->

		<int name="speed_kmh" value="0" />

		<int name="gear" value="0" />

		<!-- maps to GearPosition enum -->

		<string name="gear_str" value="P" />

		<!-- firmware sets: P R N D B -->

		<int name="regen_level" value="0" />

		<!-- 0–3 paddle regen steps -->



		<!-- ── Power & energy ─────────────────────────────── -->

		<float name="power_kw" value="0.0" />

		<!-- + discharge / - regen -->

		<int name="energy_kwh_remaining" value="0" />



		<!-- ── Battery ────────────────────────────────────── -->

		<int name="state_of_charge_pct" value="100" />

		<float name="battery_voltage_v" value="0.0" />

		<float name="battery_current_a" value="0.0" />

		<int name="batt_temp_c" value="0" />



		<!-- ── Motor / inverter ───────────────────────────── -->

		<int name="motor_temp_c" value="0" />

		<int name="inverter_temp_c" value="0" />

		<int name="motor_rpm" value="0" />



		<!-- ── Trip / odometer ───────────────────────────── -->

		<int name="odometer_km" value="0" />

		<int name="trip_km" value="0" />

		<int name="range_est_km" value="0" />



		<!-- ── Clock (from ZombieVerter Hour / Min spot values) ─── -->

		<int name="hour" value="0" />

		<int name="minute" value="0" />



		<!-- ── Turn signals (GPIO inputs, not in ZombieVerter) ──── -->

		<int name="blinker_left" value="0" />

		<int name="blinker_right" value="0" />



		<!-- ── Right info gauge ───────────────────────────── -->

		<int name="info_panel" value="0" />

		<!-- InfoPanel enum; 0–2 always, 3 when charging -->

		<int name="cell_balance_mv" value="0" />

		<int name="state_of_health_pct" value="0" />

		<!-- Set to 1 after once-per-drive BMS cell snapshot -->
		<int name="cell_health_ready" value="0" />

		<int name="efficiency_wh_per_km" value="0" />

		<int name="trip_wh_used" value="0" />

		<!-- trip energy integrator (Wh), reset with trip button -->

		<float name="aux_voltage_v" value="0.0" />

		<float name="charge_amps_a" value="0.0" />



		<!-- ── System status ─────────────────────────────── -->

		<int name="sys_state" value="4" />

		<!-- maps to SysState -->

		<int name="fault_code" value="0" />



		<int name="dark_theme" value="0" help="0:light 1:dark" />



		<int name="speed_needle_angle" value="-1090" />

		<int name="power_needle_angle" value="0" />

	</subjects>



	<images>

		<!-- Firmware uses dial_speed_dial composite (tools/gen_image_data.ps1), not these entries directly -->

		<data name="dial_speed_needle" color_format="argb8888" src_path="images/sc_dial_speed_needle.png" />

		<!-- dial_speed_dial is the composite face+border baked by tools/gen_image_data_lvgl.ps1.

		     The src_path here is for editor preview only; firmware uses the generated C embed. -->

		<data

			name="dial_speed_dial"

			color_format="argb8888"

			src_path="images/sc_dial_speed_face_border.png"

		/>

	</images>



	<fonts>

		<bin name="font_display" as_file="false" src_path="fonts/BigShoulders-Bold.ttf" size="54" bpp="4" />

		<bin name="font_heading" as_file="false" src_path="fonts/BigShoulders-Bold.ttf" size="25" bpp="4" />

		<bin name="font_subhead" as_file="false" src_path="fonts/BigShoulders-Bold.ttf" size="18" bpp="4" />

		<bin name="font_body" as_file="false" src_path="fonts/BigShoulders-Bold.ttf" size="16" bpp="4" />

		<bin name="font_small" as_file="false" src_path="fonts/BigShoulders-Bold.ttf" size="12" bpp="4" />

	</fonts>

</globals>


